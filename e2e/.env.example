# Copy to e2e/.env and adjust to match backend/.env admin credentials.
# Default ports 5174/8001 avoid clashing with dev (5173/8000).
E2E_BASE_URL=http://localhost:5174
E2E_API_URL=http://localhost:8001
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me-admin-password
# Set to 1 to run live Scope Analysis generation (calls Gemini; slow).
E2E_LIVE_GENERATE=0
