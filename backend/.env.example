APP_ENV=development
SKIP_STARTUP_CHECKS=false
TRUST_X_FORWARDED_FOR=false
DATABASE_URL=postgresql+psycopg://scopedesk:scopedesk@localhost:5432/scopedesk
# Optional: pytest migration tests use scopedesk_test derived from DATABASE_URL
# TEST_DATABASE_URL=postgresql+psycopg://scopedesk:scopedesk@localhost:5432/scopedesk_test
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model-id
S3_ENDPOINT_URL=http://localhost:9100
S3_BUCKET=scopedesk
S3_ACCESS_KEY=match-minio-root-user-from-repo-root-env
S3_SECRET_KEY=match-minio-root-password-from-repo-root-env
S3_REGION=us-east-1
S3_TEST_BUCKET=scopedesk-test
S3_PATH_STYLE=true
MAX_UPLOAD_FILE_BYTES=10485760
MAX_FILES_PER_INPUT=10
MAX_EXTRACTED_TEXT_CHARS=500000
JWT_SECRET=change-me-use-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FULL_NAME=ScopeDesk Admin
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GENERATION_TIMEOUT_SECONDS=300
GENERATION_RECOVERY_MARGIN_SECONDS=60
MAX_CONCURRENT_GENERATIONS=2
MAX_PROMPT_CHARS=300000
SOFT_CAP_AMBIGUITIES=25
SOFT_CAP_DEPENDENCIES=20
SOFT_CAP_ASSUMPTIONS=20
